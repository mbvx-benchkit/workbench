# WORKBENCH: private data must never be included in source control.
# Rules apply throughout this repository. Override only after reviewing a file.

# OS / editor / transient files
.DS_Store
.AppleDouble
__MACOSX/
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# Dependencies, build caches and logs
node_modules/
*.tsbuildinfo
*.js.map
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Secrets, authentication and local configurations
.env
.env.*
!.env.example
.npmrc
*.pem
*.key
*.p12
*.pfx
*.kdbx
*.asc
*.gpg
*.pgp
id_rsa*
id_ed25519*

# Business documents, screenshots, scans, images and other binary/media files
*.pdf
*.PDF
*.png
*.PNG
*.jpg
*.JPG
*.jpeg
*.JPEG
*.webp
*.gif
*.heic
*.heif
*.bmp
*.tif
*.tiff
*.avif
*.svg
*.ico
!/favicon.ico
*.psd
*.ai
*.eps
*.mp3
*.m4a
*.wav
*.mp4
*.mov

# Backups and exports
*.zip
*.wbenc
*.ZIP
*.7z
*.rar
*.tar
*.tgz
*.gz
*.bz2
*.bak
*.backup
*.old
*.sqlite
*.sqlite3
*.db
*.db3
*.sql

# Customer / business datasets and generated documents
*.csv
*.tsv
*.xls
*.xlsx
*.ods
*.doc
*.docx
*.odt
*.rtf
*.ppt
*.pptx
*.pages
*.numbers
*.keynote

# Ignore JSON data by default. Keep only required Node/TypeScript configs.
*.json
!package.json
!package-lock.json
!/release-notes.json
!tsconfig.json
!tsconfig.*.json
!**/tsconfig.json
!**/tsconfig.*.json

# Private working directories; no production runtime assets should live here.
source-pdf/
backups/
/backup/
exports/
output/
downloads/
private/
secrets/
local-data/
temp/
tmp/

# Editable document samples are local-only, not public repository content.
document_builder/json/

# Other files frequently used for personal notes and raw data exports.
# Tracked source documentation is retained. Only these reviewed root docs may be added.
*.txt
*.md
*.markdown
*.xml
*.yaml
*.yml
*.dat
*.jsonl
*.ndjson
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
!/README.md
!/CHANGELOG.md
!/COPYRIGHT.md
!/SECURITY_GUIDE.md
!/CSP_GUIDE.md
!/SECURITY_FIXES.md
!/document_builder/PRINT_HISTORY.md

# Reviewed GitHub configuration (no blanket YAML exception).
!/.github/workflows/security.yml
!/.github/workflows/codeql.yml
!/.github/workflows/pages.yml
!/.github/dependabot.yml

# Generated outputs: never commit; CI builds and audits from source.
/dist/
/gosplan13/dist/
/inventory_batch/dist/
/red_index/dist/
/document_builder/dist/
/site/

# Python test caches.
__pycache__/
*.pyc
